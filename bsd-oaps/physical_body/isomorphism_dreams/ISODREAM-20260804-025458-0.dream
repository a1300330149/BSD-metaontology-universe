                'boundary_corrections': sum(1 for c in corrections if c['type'] == '边界修正'),
                'weight_corrections': sum(1 for c in corrections if c['type'] == '权重修正'),
                'axiom_completions': sum(1 for c in corrections if c['type'] == '公理补全'),
