  },
  
  "network": {
    "default": "restricted",
    "allow": ["all_academic_api", "general_search_api"],
    "deny": [],
    "pipeline_control_enable": true
  },
  
  "subsystem_isolation": {
    "default_enable": true,
    "cross_access_requires_whitelist": true
  }
}